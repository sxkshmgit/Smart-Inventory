# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (same cluster as auth-service, different database)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=product_db

# Must be the SAME secret as auth-service, so this service can verify its tokens.
SECRET_KEY=change-me
ALGORITHM=HS256
